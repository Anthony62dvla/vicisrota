# Optional VicisRota settings. After changing anything here, run ./update.sh

# Error tracking (optional until a Sentry project exists)
SENTRY_DSN=

# Text message alerts. Leave SMS_PROVIDER empty to only log texts (nothing is sent).
# Set SMS_PROVIDER=http to send through any bulk SMS provider's HTTP API, configured below.
# Placeholders: {{to}} (+447...), {{to_digits}} (447...), {{body}}, {{from}}.
SMS_PROVIDER=
SMS_FROM=VicisRota
SMS_HTTP_URL=
# POST (default) or GET
SMS_HTTP_METHOD=
# json (default) or form
SMS_HTTP_BODY_TYPE=
# Example: {"to":"{{to_digits}}","message":"{{body}}","from":"{{from}}"}
SMS_HTTP_BODY=
# Extra headers as JSON, for example {"Authorization":"Bearer <key>"}
SMS_HTTP_HEADERS=
# Optional: a pattern the reply must match to count as sent, and one whose first group is the provider's reference
SMS_HTTP_SUCCESS=
SMS_HTTP_REF=

# Support assistant: suggests a triage and a reply for problem reports in the superadmin Support inbox.
# Leave empty to answer reports by hand. Get a key at https://platform.claude.com
ANTHROPIC_API_KEY=

# Sending hours to Xero Payroll. Leave empty and the Xero section stays hidden.
# Create an app at https://developer.xero.com with the redirect URI https://vicisrota.app/api/xero/callback
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# Payments through Stripe. Leave empty and nothing is ever paused or charged.
# Use test keys (sk_test_...) first. See docs/DEPLOY.md, "Switching on payments".
STRIPE_SECRET_KEY=
# From the webhook endpoint you add in Stripe for https://www.vicisrota.app/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
