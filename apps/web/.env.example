# Postgres connection for the app (a non-superuser role, so row-level security applies)
DATABASE_URL=postgres://vicisrota:vicisrota@localhost:5432/vicisrota
# Sign-in: a long random string (openssl rand -base64 32) and the site's public URL
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Error tracking (optional until a Sentry project exists)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Public address of the app, used in links inside text messages
APP_URL=http://localhost:3000
# Text message alerts. Leave SMS_PROVIDER empty to only log texts (nothing is sent).
# Set SMS_PROVIDER=http to send through any bulk SMS provider's HTTP API, configured below.
# Placeholders: {{to}} (+447...), {{to_digits}} (447...), {{body}}, {{from}}.
SMS_PROVIDER=
SMS_FROM=VicisRota
SMS_HTTP_URL=
# POST (default) or GET
SMS_HTTP_METHOD=
# json (default) or form
SMS_HTTP_BODY_TYPE=
# Example: {"to":"{{to_digits}}","message":"{{body}}","from":"{{from}}"}
SMS_HTTP_BODY=
# Extra headers as JSON, for example {"Authorization":"Bearer <key>"}
SMS_HTTP_HEADERS=
# Optional: a pattern the reply must match to count as sent, and one whose first group is the provider's reference
SMS_HTTP_SUCCESS=
SMS_HTTP_REF=
# A long random string. The scheduler calls /api/cron/alerts with "Authorization: Bearer <CRON_SECRET>" every few minutes.
CRON_SECRET=
