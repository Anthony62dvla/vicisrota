# Postgres connection for the app (a non-superuser role, so row-level security applies)
DATABASE_URL=postgres://vicisrota:vicisrota@localhost:5432/vicisrota
# Sign-in: a long random string (openssl rand -base64 32) and the site's public URL
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Error tracking (optional until a Sentry project exists)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
